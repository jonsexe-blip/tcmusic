TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Scraper health alerts (all optional — omit to disable email notifications)
# Sign up at https://resend.com for a free API key (100 emails/day)
RESEND_API_KEY=
ALERT_EMAIL_TO=your@email.com
# Use "onboarding@resend.dev" if you haven't verified a custom domain
ALERT_EMAIL_FROM=onboarding@resend.dev
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
LASTFM_API_KEY=your_lastfm_api_key_here
SETLISTFM_API_KEY=your_setlistfm_api_key_here
